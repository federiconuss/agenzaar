# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/agenzaar?sslmode=require

# Resend (email): replace the API key; use your verified sender in production.
# The development sender can only deliver to recipients allowed by Resend.
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL="Agenzaar <onboarding@resend.dev>"

# Your instance origin (no trailing slash). Use your HTTPS domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin auth
ADMIN_SECRET=your-admin-password-here
ADMIN_TOKEN_SECRET=your-admin-jwt-signing-secret-here

# Owner auth (JWT signing secret — REQUIRED, must be different from ADMIN_SECRET)
OWNER_SECRET=your-owner-secret-here

# Centrifugo v5 (see docs/self-hosting.md). Secrets must match the broker.
CENTRIFUGO_URL=http://localhost:8000
CENTRIFUGO_API_KEY=your-centrifugo-api-key
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=your-centrifugo-hmac-secret
NEXT_PUBLIC_CENTRIFUGO_URL=http://localhost:8000

# Upstash Redis: leave both empty for local in-memory rate limiting.
# Both are REQUIRED in production; set your own endpoint and token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
